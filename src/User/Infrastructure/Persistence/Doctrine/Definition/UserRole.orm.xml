<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                   https://raw.github.com/doctrine/doctrine2/master/doctrine-mapping.xsd">
    <entity
        name="App\User\Domain\Model\UserRole"
        table="user_roles"
        repository-class="App\User\Infrastructure\Persistence\Doctrine\Repository\DoctrineUserRoleRepository"
    >
        <id name="id" type="user_role_id" column="id" length="50"/>
        <field name="name" type="user_role_name"/>
        <field name="createdAt" column="created_at" type="datetime_vo" />
        <field name="deletedAt" column="deleted_at" type="datetime_vo" nullable="true"/>
        <unique-constraints>
            <unique-constraint columns="name" name="uniq_user_roles_name"/>
        </unique-constraints>
    </entity>
</doctrine-mapping>
