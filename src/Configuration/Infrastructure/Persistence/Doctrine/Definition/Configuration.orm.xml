<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                   https://raw.github.com/doctrine/doctrine2/master/doctrine-mapping.xsd">
    <entity
            name="App\Configuration\Domain\Model\Configuration"
            table="configurations"
            repository-class="App\Configuration\Infrastructure\Persistence\Doctrine\Repository\DoctrineConfigurationRepository"
    >
        <id name="id" type="configuration_id" column="id" length="36"/>
        <field name="key" column="config_key" unique="true" type="configuration_key"/>
        <field name="value" column="value" type="configuration_value"/>
        <field name="type" column="type" type="configuration_type" length="20"/>
        <field name="description" column="description" type="configuration_description" nullable="true"/>
        <field name="isSensitive" column="is_sensitive" type="bool_vo"/>
        <field name="keyVersion" column="key_version" type="smallint" nullable="true"/>
        <field name="createdAt" column="created_at" type="datetime_vo"/>
        <field name="updatedAt" column="updated_at" type="datetime_vo"/>
    </entity>
</doctrine-mapping>
