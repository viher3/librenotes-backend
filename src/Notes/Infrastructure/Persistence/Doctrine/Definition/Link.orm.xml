<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                   https://raw.github.com/doctrine/doctrine2/master/doctrine-mapping.xsd">
    <entity
            name="App\Notes\Domain\Model\Link"
            table="link"
            repository-class="App\Notes\Infrastructure\Persistence\Doctrine\Repository\DoctrineLinkRepository"
    >
        <id name="id" type="link_id" column="id" length="36"/>
        <field name="title" column="title" type="link_title"/>
        <field name="url" column="url" type="link_url" length="2048"/>
        <field name="note" column="note" type="link_note" nullable="true"/>
        <field name="tags" column="tags" type="notes_tags" nullable="true"/>
        <field name="folderId" column="folder_id" type="folder_id" length="36" nullable="true"/>
        <field name="ownerId" column="owner_id" type="notes_owner_id" length="36"/>
        <field name="createdAt" column="created_at" type="datetime_vo"/>
        <field name="updatedAt" column="updated_at" type="datetime_vo"/>
        <field name="deletedAt" column="deleted_at" type="datetime_vo" nullable="true"/>
        <indexes>
            <index name="idx_link_owner_folder" columns="owner_id,folder_id"/>
            <index name="idx_link_owner_deleted" columns="owner_id,deleted_at"/>
        </indexes>
    </entity>
</doctrine-mapping>
