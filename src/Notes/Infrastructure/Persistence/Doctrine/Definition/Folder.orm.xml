<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                   https://raw.github.com/doctrine/doctrine2/master/doctrine-mapping.xsd">
    <entity
            name="App\Notes\Domain\Model\Folder"
            table="folder"
            repository-class="App\Notes\Infrastructure\Persistence\Doctrine\Repository\DoctrineFolderRepository"
    >
        <id name="id" type="folder_id" column="id" length="36"/>
        <field name="name" column="name" type="folder_name"/>
        <field name="parentFolderId" column="parent_folder_id" type="folder_id" length="36" nullable="true"/>
        <field name="ownerId" column="owner_id" type="notes_owner_id" length="36"/>
        <field name="createdAt" column="created_at" type="datetime_vo"/>
        <field name="updatedAt" column="updated_at" type="datetime_vo"/>
        <indexes>
            <index name="idx_folder_owner_parent" columns="owner_id,parent_folder_id"/>
        </indexes>
    </entity>
</doctrine-mapping>
