<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                   https://raw.github.com/doctrine/doctrine2/master/doctrine-mapping.xsd">
    <entity
            name="App\Notes\Domain\Model\Note"
            table="note"
            repository-class="App\Notes\Infrastructure\Persistence\Doctrine\Repository\DoctrineNoteRepository"
    >
        <id name="id" type="note_id" column="id" length="36"/>
        <field name="title" column="title" type="note_title"/>
        <field name="content" column="content" type="note_content"/>
        <field name="icon" column="icon" type="notes_icon" length="32" nullable="true"/>
        <field name="folderId" column="folder_id" type="folder_id" length="36" nullable="true"/>
        <field name="parentNoteId" column="parent_note_id" type="note_id" length="36" nullable="true"/>
        <field name="ownerId" column="owner_id" type="notes_owner_id" length="36"/>
        <field name="pinned" column="pinned" type="bool_vo">
            <options>
                <option name="default">0</option>
            </options>
        </field>
        <field name="tags" column="tags" type="notes_tags" nullable="true"/>
        <field name="createdAt" column="created_at" type="datetime_vo"/>
        <field name="updatedAt" column="updated_at" type="datetime_vo"/>
        <field name="deletedAt" column="deleted_at" type="datetime_vo" nullable="true"/>
        <indexes>
            <index name="idx_note_owner_folder" columns="owner_id,folder_id"/>
            <index name="idx_note_owner_parent" columns="owner_id,parent_note_id"/>
            <index name="idx_note_owner_deleted" columns="owner_id,deleted_at"/>
        </indexes>
    </entity>
</doctrine-mapping>
